{
    "name": "GitHub Insights Design System",
    "version": "1.0.0",
    "tokens": {
        "colors": {
            "background": "#050505",
            "surface": "#09090b",
            "border": "#27272a",
            "primary": "#fafafa",
            "secondary": "#71717a",
            "accent": "#3b82f6"
        },
        "typography": {
            "fontFamily": "Inter, system-ui, sans-serif",
            "baseSize": "14px",
            "weights": {
                "normal": "400",
                "medium": "500",
                "semibold": "600",
                "bold": "700"
            }
        },
        "spacing": {
            "base": "4px",
            "cardPadding": "24px",
            "containerGap": "32px"
        },
        "borderRadius": {
            "sm": "4px",
            "md": "6px",
            "lg": "8px",
            "xl": "12px",
            "button": "6px"
        },
        "shadows": {
            "default": "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05)",
            "premium": "0 20px 25px -5px rgba(0, 0, 0, 0.2), 0 10px 10px -5px rgba(0, 0, 0, 0.1)"
        }
    }
}
